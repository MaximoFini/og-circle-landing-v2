# Variables de entorno de la demo de la calculadora (app/api/demo/**).
# La landing en sí no necesita ninguna: sin estas variables el sitio compila y
# anda igual, solo que la demo funciona en modo degradado (ver abajo).
#
# Copiar a .env.local para desarrollo. En Vercel: Project → Settings → Environment Variables.

# ── IA ───────────────────────────────────────────────────────────────────
# Clave de la API de Anthropic (console.anthropic.com).
# Sin ella /api/demo/identify degrada a búsqueda textual local (fuente:"local")
# y /api/demo/analyze responde 503. Nunca tira 500.
ANTHROPIC_API_KEY=sk-ant-...

# Overrides opcionales de modelo. Defaults: identify=claude-sonnet-5,
# analyze=claude-haiku-4-5.
# ANTHROPIC_MODEL_IDENTIFY=claude-sonnet-5
# ANTHROPIC_MODEL_ANALYZE=claude-haiku-4-5

# ── Store de cuotas (Vercel KV / Upstash Redis) ──────────────────────────
# Las dos las inyecta Vercel sola al conectar un store KV al proyecto.
# Si faltan, en dev se usa un Map en memoria; en prod eso NO alcanza (cada
# lambda tiene el suyo), así que el límite por visitante se vuelve inútil.
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=

# ── Cuotas ───────────────────────────────────────────────────────────────
# Secreto para firmar la cookie httpOnly del visitante y hashear la IP.
# Cualquier string largo y aleatorio: `openssl rand -base64 32`.
# Si lo cambiás, todas las cookies emitidas dejan de valer (los visitantes
# recuperan sus usos).
DEMO_COOKIE_SECRET=

# Tope global de llamadas a IA por día (identify + analyze juntas). Es la red
# de seguridad real del gasto: el límite por visitante es UX (la cookie se
# borra, la IP se cambia con una VPN). Default 200.
DEMO_DAILY_CAP=200
